<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VpnIpTable.Core\VpnIpTable.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <Target Name="LinkAddressesYaml" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and Exists('$(MSBuildProjectDirectory)\..\addresses.yaml')">
    <Delete Files="$(TargetDir)addresses.yaml" TreatErrorsAsWarnings="true" />
    <Exec Command="cmd /c mklink /H &quot;$(TargetDir)addresses.yaml&quot; &quot;$(MSBuildProjectDirectory)\..\addresses.yaml&quot;" />
  </Target>

</Project>
